# =============================================================================
# 楽天ROOM 自動投稿システム - 環境変数
# このファイルを .env としてコピーして、各値を埋めてください
#   $ cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 楽天会員（投稿アカウント）
# -----------------------------------------------------------------------------
# 楽天IDログインに使うメールアドレス／パスワード
RAKUTEN_EMAIL=your-email@example.com
RAKUTEN_PASSWORD=your-password

# 楽天ROOM のユーザーID
# プロフィールURL末尾の文字列です: room.rakuten.co.jp/<ここがID>
ROOM_USER_ID=your_room_user_id

# -----------------------------------------------------------------------------
# 楽天ウェブサービス API
# 取得手順: https://webservice.rakuten.co.jp/
# アプリID登録 → application ID と access key を取得
# -----------------------------------------------------------------------------
RAKUTEN_APP_ID=your_application_id
RAKUTEN_ACCESS_KEY=your_access_key

# -----------------------------------------------------------------------------
# エージェントタイプ(オプション・上級者向け)
# -----------------------------------------------------------------------------
# このシステムは Claude Code(デフォルト) で動作します。
# 設定不要のまま使うのが推奨。
#
# Codex CLI(OpenAI)で実験的に動かしたい場合のみ、以下のコメントを外す:
#
# AGENT_TYPE=codex
# OPENAI_API_KEY=sk-...
#
# Codex 対応は参考情報扱いで、Claude Code と同じ品質の投稿が出る保証はありません。
# 詳細は別途配布の「Codex CLI で動かす場合の参考ガイド」を参照してください。
